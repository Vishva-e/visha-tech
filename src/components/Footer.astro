---
import { brand } from '../data/site';
const amazonActive = import.meta.env.PUBLIC_AMAZON_ASSOCIATE_ACTIVE === 'true';
---
<footer class="site-footer">
  <div class="shell"><div class="footer-banner"><div><span class="eyebrow">THE NEXT MOVE</span><h2>Not sure what to pick?</h2><p>Start with your needs. We\u2019ll help you find the features worth checking.</p></div><a class="btn btn-primary" href="/product-finder/">Try the tech finder <span aria-hidden="true">↗</span></a></div></div>
  <div class="shell footer-layout">
    <div class="footer-brand">
      <a href="/" class="brand footer-logo"><span class="brand-mark" aria-hidden="true">V</span><span class="brand-title">Visha <strong>Shop</strong></span></a>
      <p>Curated technology guidance, smarter choices and practical advice for everyday life.</p>
      {amazonActive ? <p class="footer-disclosure">As an Amazon Associate I earn from qualifying purchases.</p> : <p class="footer-disclosure">Affiliate links may be introduced after programme verification. <a href="/affiliate-disclosure/">Read our disclosure</a>.</p>}
    </div>
    <div class="footer-links"><h2>Explore</h2><a href="/guides/">All guides</a><a href="/comparisons/">Comparisons</a><a href="/categories/laptops/">Laptops</a><a href="/categories/developer-gear/">Developer gear</a></div>
    <div class="footer-links"><h2>Information</h2><a href="/about/">About us</a><a href="/editorial-policy/">Editorial policy</a><a href="/affiliate-disclosure/">Affiliate disclosure</a><a href="/privacy/">Privacy</a><a href="/contact/">Contact</a></div>
  </div>
  <div class="shell footer-bottom"><span>© {new Date().getUTCFullYear()} {brand.copyrightOwner}. All rights reserved.</span><span>Better tech decisions start here.</span></div>
</footer>
