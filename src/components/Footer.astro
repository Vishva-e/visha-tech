---
import { brand } from '../data/site';
const amazonActive = import.meta.env.PUBLIC_AMAZON_ASSOCIATE_ACTIVE === 'true';
---
<footer class="site-footer visha-footer">
  <div class="shell">
    <div class="visha-footer-feature">
      <div>
        <span class="visha-small-label">VISHA SHOP</span>
        <h2>Choose better. Feel better about it.</h2>
        <p>A clearer path to your next tech purchase starts with the right questions.</p>
      </div>
      <a class="visha-pill-link" href="/product-finder/">Find your next upgrade <span aria-hidden="true">↗</span></a>
    </div>
    <div class="visha-footer-navigation">
      <div class="visha-footer-about">
        <a class="brand" href="/" aria-label="Visha Shop home"><span class="brand-mark" aria-hidden="true">V</span><span class="brand-title">Visha <strong>Shop</strong></span></a>
        <p>Independent buying guides for people who care about choosing well.</p>
      </div>
      <nav aria-label="Shop footer links" class="visha-footer-links">
        <h3>Explore</h3>
        <a href="/shop/">Shop categories</a>
        <a href="/categories/laptops/">Laptops</a>
        <a href="/categories/developer-gear/">Developer gear</a>
        <a href="/categories/audio/">Audio</a>
        <a href="/categories/storage/">Storage</a>
      </nav>
      <nav aria-label="Discover footer links" class="visha-footer-links">
        <h3>Discover</h3>
        <a href="/guides/">Buying guides</a>
        <a href="/comparisons/">Comparisons</a>
        <a href="/product-finder/">Product finder</a>
        <a href="/guides/how-much-ram-for-developers/">RAM for developers</a>
      </nav>
      <nav aria-label="Company and policies" class="visha-footer-links">
        <h3>About Visha</h3>
        <a href="/about/">About us</a>
        <a href="/editorial-policy/">Editorial standards</a>
        <a href="/affiliate-disclosure/">Affiliate disclosure</a>
        <a href="/privacy/">Privacy policy</a>
        <a href="/contact/">Contact</a>
      </nav>
    </div>
    <div class="visha-footer-disclosure">
      {amazonActive ? <p>As an Amazon Associate I earn from qualifying purchases.</p> : <p>We currently provide editorial research. Affiliate links may be added after programme verification and are subject to clear disclosure.</p>}
    </div>
    <div class="visha-footer-bottom">
      <span>© {new Date().getUTCFullYear()} {brand.copyrightOwner}. All rights reserved.</span>
      <a href="/privacy/">Privacy</a>
      <a href="/affiliate-disclosure/">Disclosures</a>
      <span class="visha-footer-location">Made for India</span>
    </div>
  </div>
</footer>
