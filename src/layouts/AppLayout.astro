---
import { categories } from '../data/site';
import { productCandidates } from '../data/product-candidates.mjs';
import '../styles/global.css';
import '../styles/app-workspace.css';
import '../styles/workspace-enhancements.css';

interface Props {
  title: string;
  description: string;
  section: 'overview' | 'library' | 'saved' | 'detail' | 'product';
  breadcrumb?: string;
}
const { title, description, section, breadcrumb } = Astro.props;
const live = import.meta.env.PUBLIC_SITE_LIVE === 'true';
const canonical = live && Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const navigation = [
  { label: 'Overview', href: '/dashboard/', id: 'overview', icon: 'grid' },
  { label: 'Explore library', href: '/dashboard/library/', id: 'library', icon: 'book' },
  { label: 'Saved guides', href: '/dashboard/saved/', id: 'saved', icon: 'bookmark' },
  { label: 'Product spotlight', href: `/dashboard/products/${productCandidates[0].id}/`, id: 'product', icon: 'cube' },
] as const;
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f4f6" />
    <meta name="description" content={description} />
    <meta name="robots" content={live ? 'index,follow,max-image-preview:large' : 'noindex,nofollow,noarchive'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} | Visha Shop</title>
  </head>
  <body class="visha-app-body">
    <a href="#main" class="skip-link">Skip to main content</a>
    <div class="visha-app-shell" id="visha-app">
      <div class="visha-app-scrim" id="app-scrim" hidden></div>
      <aside class="visha-app-sidebar" id="app-sidebar" aria-label="Workspace navigation">
        <div class="visha-app-sidebar-top">
          <a class="visha-app-brand" href="/dashboard/" aria-label="Visha Shop Workspace home"><span aria-hidden="true" class="visha-app-logo">V</span><span class="visha-app-brand-name">Visha <strong>Shop</strong><small>Workspace</small></span></a>
          <button type="button" class="visha-app-close-sidebar" id="app-close-sidebar" aria-label="Close sidebar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" stroke-linecap="round"/></svg></button>
        </div>
        <div class="visha-sidebar-scroll">
          <p class="visha-app-nav-heading">WORKSPACE</p>
          <nav class="visha-sidebar-nav" aria-label="Workspace sections">
            {navigation.map(item => <a class:list={['visha-app-nav-link', { 'is-active': section === item.id || (section === 'detail' && item.id === 'library') }]} href={item.href} aria-current={section === item.id || (section === 'detail' && item.id === 'library') ? 'page' : undefined}>
              <span class="visha-app-nav-symbol" aria-hidden="true">
                {item.icon === 'grid' ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="8" height="8" rx="2"/><rect x="13" y="3" width="8" height="8" rx="2"/><rect x="3" y="13" width="8" height="8" rx="2"/><rect x="13" y="13" width="8" height="8" rx="2"/></svg> :
                 item.icon === 'book' ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 6c-3.2-2.3-6.2-2.4-9-1v14c3-1.2 6-1.1 9 1 3-2.1 6-2.2 9-1V5c-3-1.4-5.8-1.3-9 1Zm0 0v14"/></svg> :
                 item.icon === 'bookmark' ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 4h12v17l-6-4-6 4V4Z" stroke-linejoin="round"/></svg> :
                 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2 21 7v10l-9 5-9-5V7l9-5Zm0 0v20M3 7l9 5 9-5" stroke-linejoin="round"/></svg>}
              </span><span class="visha-app-nav-name">{item.label}</span>{item.id === 'saved' && <span class="visha-app-saved-number" id="app-saved-counter" aria-label="Number of saved guides">0</span>}
            </a>)}
          </nav>
          <div class="visha-app-nav-divider"></div>
          <p class="visha-app-nav-heading">CATEGORIES</p>
          <nav class="visha-sidebar-nav visha-app-category-nav" aria-label="Guide categories">
            {categories.map(category => <a class="visha-app-nav-link visha-app-category-link" href={`/dashboard/library/?category=${category.slug}`}>
              <span class="visha-app-category-bullet" aria-hidden="true"></span><span class="visha-app-nav-name">{category.name}</span>
            </a>)}
          </nav>
        </div>
        <div class="visha-app-sidebar-bottom">
          <a href="/" class="visha-app-back-site"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m14 6-6 6 6 6M8 12h12" stroke-linecap="round"/></svg><span class="visha-app-nav-name">Back to Visha Shop</span></a>
          <div class="visha-app-privacy-note">Your saved list stays in this browser.</div>
        </div>
      </aside>
      <div class="visha-app-stage">
        <header class="visha-app-toolbar">
          <div class="visha-app-toolbar-leading">
            <button id="app-sidebar-toggle" class="visha-app-icon-button" type="button" aria-label="Toggle sidebar" aria-controls="app-sidebar" aria-expanded="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="M9 4v16" /></svg></button>
            <span class="visha-app-toolbar-divider" aria-hidden="true"></span>
            <nav class="visha-app-breadcrumbs" aria-label="Breadcrumb"><a href="/dashboard/">Workspace</a><span aria-hidden="true">/</span><span aria-current="page">{breadcrumb ?? title}</span></nav>
          </div>
          <div class="visha-app-toolbar-trailing">
            <a href="/dashboard/library/" class="visha-app-search-command" aria-label="Search guides"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.6" cy="10.6" r="6.6"/><path d="m15.5 15.5 5 5" stroke-linecap="round"/></svg><span>Search library</span><kbd>/</kbd></a>
            <a class="visha-app-avatar" href="/about/" aria-label="About Visha Shop">V</a>
          </div>
        </header>
        <main id="main" class="visha-app-main"><slot /></main>
      </div>
    </div>
    <script>
      import { getSavedIds, subscribeToSavedChanges, toggleSaved } from '../lib/reading-list';
      const app = document.querySelector<HTMLElement>('#visha-app');
      const toggle = document.querySelector<HTMLButtonElement>('#app-sidebar-toggle');
      const close = document.querySelector<HTMLButtonElement>('#app-close-sidebar');
      const scrim = document.querySelector<HTMLElement>('#app-scrim');
      const counter = document.querySelector<HTMLElement>('#app-saved-counter');
      function setSidebar(open: boolean) {
        const mobile = window.matchMedia('(max-width: 900px)').matches;
        app?.classList.toggle('sidebar-open', open && mobile);
        app?.classList.toggle('sidebar-collapsed', !open && !mobile);
        if (scrim) scrim.hidden = !mobile || !open;
        toggle?.setAttribute('aria-expanded', String(open));
        document.body.classList.toggle('visha-app-lock-scroll', mobile && open);
      }
      toggle?.addEventListener('click', () => setSidebar(window.matchMedia('(max-width: 900px)').matches ? !Boolean(app?.classList.contains('sidebar-open')) : Boolean(app?.classList.contains('sidebar-collapsed'))));
      close?.addEventListener('click', () => { setSidebar(false); toggle?.focus(); });
      scrim?.addEventListener('click', () => setSidebar(false));
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape' && app?.classList.contains('sidebar-open')) { setSidebar(false); toggle?.focus(); }
        if (event.key === '/' && !(event.target instanceof HTMLInputElement) && !(event.target instanceof HTMLTextAreaElement) && !(event.target instanceof HTMLSelectElement) && !event.metaKey && !event.ctrlKey && !event.altKey) {
          event.preventDefault();
          const libraryInput = document.querySelector<HTMLInputElement>('#app-library-search');
          if (libraryInput) libraryInput.focus();
          else window.location.assign('/dashboard/library/?focus=search');
        }
      });
      window.addEventListener('resize', () => { if (window.innerWidth > 900 && app?.classList.contains('sidebar-open')) setSidebar(true); else if (window.innerWidth <= 900) { app?.classList.remove('sidebar-collapsed'); toggle?.setAttribute('aria-expanded','false'); } });
      const updateCounter = () => { if (counter) counter.textContent = String(getSavedIds().length); };
      const updateSaveUI = () => {
        const saved = new Set(getSavedIds());
        document.querySelectorAll<HTMLButtonElement>('[data-save-guide]').forEach(button => {
          const slug = button.dataset.saveGuide || '';
          const active = saved.has(slug);
          button.setAttribute('aria-pressed', String(active));
          const label = button.querySelector<HTMLElement>('[data-save-label]');
          if (label) label.textContent = active ? 'Saved' : 'Save';
          button.setAttribute('aria-label', (active ? 'Remove saved guide: ' : 'Save guide: ') + (button.dataset.guideTitle || slug));
        });
        const summary = document.querySelector<HTMLElement>('#dashboard-saved-count');
        if (summary) summary.textContent = String(saved.size);
      };
      document.addEventListener('click', event => {
        const target = event.target;
        const button = target instanceof Element ? target.closest<HTMLButtonElement>('[data-save-guide]') : null;
        if (button?.dataset.saveGuide) {
          toggleSaved(button.dataset.saveGuide);
          updateSaveUI();
        }
      });
      updateCounter();
      updateSaveUI();
      subscribeToSavedChanges(() => { updateCounter(); updateSaveUI(); });
      if (window.matchMedia('(max-width: 900px)').matches) toggle?.setAttribute('aria-expanded','false');
    </script>
    <script src="/workspace-enhancements.js"></script>
  </body>
</html>
