---
import AppLayout from '../../../layouts/AppLayout.astro';
import AppGuideCard from '../../../components/AppGuideCard.astro';
import { getCollection } from 'astro:content';
const guides = (await getCollection('guides', ({data}) => !data.draft))
  .sort((a,b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime());
---
<AppLayout title="Saved guides" breadcrumb="Saved guides" section="saved" description="Revisit your saved Visha Shop guides. Saved items stay in your browser.">
  <header class="visha-app-page-heading"><div><span class="visha-app-eyebrow">YOUR READING LIST</span><h1>Saved for later.</h1><p>Keep useful guides close. Your list lives only in this browser — no account or tracking required.</p></div><a href="/dashboard/library/" class="visha-app-outline">Explore library <span aria-hidden="true">↗</span></a></header>
  <section aria-label="Saved guides" id="app-saved-section">
    <p class="visha-app-result-bar" id="app-saved-status" role="status" aria-live="polite">Loading your saved list…</p>
    <div id="app-saved-list" class="visha-app-library-list visha-app-saved-list" hidden>
      {guides.map(guide => <div data-saved-item={guide.id} hidden class="visha-app-library-item"><AppGuideCard guide={guide}/></div>)}
    </div>
    <div id="app-saved-empty" class="visha-app-empty" hidden>
      <h2>Your reading list is empty.</h2>
      <p>Save an article from the library or a guide detail page to see it here.</p>
      <a href="/dashboard/library/" class="visha-app-action">Find something worth reading <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</AppLayout>
<script>
  import { getSavedIds, subscribeToSavedChanges } from '../../../lib/reading-list';
  const savedList = document.querySelector<HTMLElement>('#app-saved-list');
  const empty = document.querySelector<HTMLElement>('#app-saved-empty');
  const status = document.querySelector<HTMLElement>('#app-saved-status');
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-saved-item]'));
  function renderSaved() {
    const ids = new Set(getSavedIds());
    let visible = 0;
    for (const item of items) {
      const show = ids.has(item.dataset.savedItem || '');
      item.hidden = !show;
      if (show) visible++;
    }
    if (savedList) savedList.hidden = visible === 0;
    if (empty) empty.hidden = visible !== 0;
    if (status) status.textContent = `${visible} saved ${visible === 1 ? 'guide' : 'guides'}`;
  }
  renderSaved();
  subscribeToSavedChanges(renderSaved);
</script>
