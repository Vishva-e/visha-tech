---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideCard from '../../components/GuideCard.astro';
import CategoryArtwork from '../../components/CategoryArtwork.astro';
import { categories } from '../../data/site';
import { productCandidates } from '../../data/product-candidates.mjs';
import { approvedAffiliateLink } from '../../lib/affiliate-link-gate.mjs';
import { getCollection } from 'astro:content';
const guides = (await getCollection('guides', ({ data }) => !data.draft))
  .sort((a,b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime());
const featured = guides.filter(guide => guide.data.featured).slice(0,3);
const selection = featured.length ? featured : guides.slice(0,3);
const product = productCandidates[0];
// Build-time gate: never serialize a paid link until account/site/editorial approvals.
const productLink = approvedAffiliateLink(product, process.env);
---
<BaseLayout title="Shop by category" description="Explore technology categories and independent buying advice for India. Research laptops, work gear, audio and storage before buying.">
  <section class="shop-hero">
    <div class="shell shop-hero-grid">
      <div>
        <span class="eyebrow">EXPLORE THE COLLECTION</span>
        <h1>Make your next tech choice a better one.</h1>
        <p>Discover categories, buying checklists and comparisons built around what you actually need. No invented discounts, review scores or live prices.</p>
        <div class="hero-buttons">
          <a class="btn btn-primary" href="#shop-categories">Browse categories <span aria-hidden="true">↗</span></a>
          <a class="btn btn-secondary" href="/product-finder/">Find my tech fit <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="shop-hero-panel" aria-label="How to choose the right technology">
        <span class="shop-hero-panel-label">THE SMART SHOPPING CHECKLIST</span>
        <div><span>01</span><strong>Start with your real use case</strong></div>
        <div><span>02</span><strong>Compare the trade-offs</strong></div>
        <div><span>03</span><strong>Check the final seller details</strong></div>
        <p>We publish independent research, not a direct checkout or a list of claimed best prices.</p>
      </div>
    </div>
  </section>
  <section id="shop-categories" class="section section-white">
    <div class="shell">
      <div class="section-heading">
        <div><span class="eyebrow">BROWSE BY CATEGORY</span><h2>Find your next upgrade</h2><p>Pick a topic to explore specifications, buying priorities and long-term value.</p></div>
        <a class="text-link" href="/guides/">All buying guides ↗</a>
      </div>
      <div class="category-grid">
        {categories.map((category,index) =>
          <a class="category-card" href={`/categories/${category.slug}/`}>
            <span class="category-card-top"><span class="category-number">{String(index + 1).padStart(2,'0')}</span><span class="category-arrow" aria-hidden="true">↗</span></span>
            <span class="category-icon" aria-hidden="true"><CategoryArtwork slug={category.slug} /></span>
            <span class="category-card-content"><h3>{category.name}</h3><p>{category.summary}</p></span>
          </a>
        )}
      </div>
    </div>
  </section>
  <section class="section section-white shop-product-section" aria-labelledby="shop-product-spotlight">
    <div class="shell">
      <div class="section-heading">
        <div><span class="eyebrow">PRODUCT SPOTLIGHT</span><h2 id="shop-product-spotlight">A product worth evaluating</h2><p>One verified product listing, independently considered — no invented prices or customer ratings.</p></div>
        <a class="text-link" href="/guides/essential-accessories-for-developers/">Mouse buying considerations ↗</a>
      </div>
      <article class="shop-product-card">
        <div class="shop-product-visual" aria-hidden="true"><span class="shop-product-symbol"><svg viewBox="0 0 120 150" role="img" aria-label="Minimal computer mouse illustration"><defs><linearGradient id="mouseMetal" x1="0" x2="1" y1="0" y2="1"><stop offset="0" stop-color="#fafafa"/><stop offset=".55" stop-color="#d6d7da"/><stop offset="1" stop-color="#adb0b7"/></linearGradient></defs><rect x="20" y="9" width="80" height="131" rx="40" fill="url(#mouseMetal)" stroke="#b2b4ba" stroke-width="2"/><path d="M60 9v37" stroke="#afb1b6" stroke-width="2"/><path d="M20 59h80" stroke="#afb1b6" stroke-width="1.5"/><rect x="57" y="30" width="6" height="16" rx="3" fill="#888b92"/></svg></span><span class="shop-product-label">Bluetooth · USB-C charging</span></div>
        <div class="shop-product-info">
          <span class="eyebrow">OWNER-SUBMITTED · EDITORIAL REVIEW PENDING</span>
          <h3>{product.title}</h3>
          <p>{product.description}</p>
          <div class="shop-product-meta"><span>ASIN: {product.asin}</span><span>Category: Developer Gear</span><span>No live price shown</span></div>
          <p class="shop-product-note">This is not a hands-on review or an independent recommendation. Check compatibility and final seller details before purchasing.</p>
          <div class="shop-product-actions">
            <a class="btn btn-secondary" href={product.guidePath}>Read buying guide <span aria-hidden="true">↗</span></a>
            {productLink ? (
              <a class="btn btn-primary" href={productLink.url} target="_blank" rel={productLink.rel}>View on Amazon <span class="shop-paid-label">{productLink.disclosure}</span></a>
            ) : (
              <span class="shop-product-pending" role="status">Affiliate link awaiting review</span>
            )}
          </div>
          {productLink && <p class="shop-affiliate-identification">As an Amazon Associate I earn from qualifying purchases. <a href="/affiliate-disclosure/">Affiliate disclosure</a>.</p>}
        </div>
      </article>
    </div>
  </section>
  <section class="section shop-featured">
    <div class="shell">
      <div class="section-heading">
        <div><span class="eyebrow">BEFORE YOU BUY</span><h2>Start with the research</h2><p>Practical guides and honest limitations before you choose a retailer.</p></div>
        <a class="text-link" href="/guides/">Explore all guides ↗</a>
      </div>
      <div class="guide-grid">{selection.map(guide => <GuideCard guide={guide} />)}</div>
    </div>
  </section>
  <section class="shop-disclosure">
    <div class="shell shop-disclosure-inner">
      <div><span class="eyebrow">TRANSPARENT BY DESIGN</span><h2>Guidance first. Commission second.</h2><p>Affiliate purchase links are not currently active. If eligible, approved paid links will be identified clearly and never replace independent editorial criteria.</p></div>
      <a href="/affiliate-disclosure/" class="btn btn-secondary">How affiliate links work <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
