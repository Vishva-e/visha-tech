---
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideCard from '../components/GuideCard.astro';
import CategoryArtwork from '../components/CategoryArtwork.astro';
import { categories } from '../data/site';
import { getCollection } from 'astro:content';
const guides = (await getCollection('guides', ({ data }) => !data.draft))
  .sort((a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime());
const featured = [...guides]
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured))
  .slice(0, 3);
---
<BaseLayout title="Home" description="Discover smarter tech shopping with Visha Shop. Explore independent laptop, developer gear, audio and storage buying guides, comparisons and practical product advice.">
  <section class="visha-home-intro">
    <div class="shell visha-intro-layout">
      <div class="visha-intro-copy">
        <span class="visha-small-label">VISHA SHOP · INDEPENDENT TECH GUIDES</span>
        <h1>Find tech that<br/><span>fits your life.</span></h1>
      </div>
      <div class="visha-intro-aside">
        <p>Thoughtful buying advice for the technology you use every day. Less noise. Better decisions.</p>
        <a href="/product-finder/" class="visha-inline-link">Find my tech fit <span aria-hidden="true">↗</span></a>
        <a href="/editorial-policy/" class="visha-inline-link muted">How we research <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="shell visha-category-rail" aria-label="Browse shopping categories">
      {categories.map(category => <a class="visha-category-quicklink" href={`/categories/${category.slug}/`}>
        <span class="visha-category-orb" aria-hidden="true"><CategoryArtwork slug={category.slug} /></span>
        <span>{category.name}</span>
      </a>)}
    </div>
  </section>
  <section class="visha-spotlight" aria-labelledby="spotlight-heading">
    <div class="shell">
      <div class="visha-spotlight-panel">
        <div class="visha-spotlight-copy">
          <span class="visha-small-label">THE SMARTER WAY TO CHOOSE</span>
          <h2 id="spotlight-heading">Meet your next<br/>better decision.</h2>
          <p>From a laptop that keeps up to the gear that makes everyday work easier. Start with what matters to you.</p>
          <div class="visha-spotlight-actions">
            <a href="/shop/" class="visha-pill-link">Explore the shop <span aria-hidden="true">↗</span></a>
            <a href="/product-finder/" class="visha-quiet-link">Get a recommendation <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="visha-device-scene" aria-hidden="true">
          <div class="visha-scene-glow"></div>
          <div class="visha-device-display">
            <div class="visha-device-camera"></div>
            <div class="visha-device-screen">
              <div class="visha-screen-kicker">VISHA SELECT</div>
              <div class="visha-screen-heading">Less noise.<br/>More clarity.</div>
              <div class="visha-screen-rule"></div>
              <div class="visha-screen-bars"><span></span><span></span><span></span></div>
            </div>
          </div>
          <div class="visha-device-bottom"></div>
        </div>
      </div>
    </div>
  </section>
  <section class="visha-editorial-section" aria-labelledby="latest-guides-heading">
    <div class="shell">
      <div class="visha-editorial-heading">
        <div>
          <span class="visha-small-label">WORTH YOUR TIME</span>
          <h2 id="latest-guides-heading">Discover the good stuff.</h2>
          <p>Clear buying guides. Real trade-offs. No invented prices or reviews.</p>
        </div>
        <a class="visha-inline-link" href="/guides/">Explore all guides <span aria-hidden="true">↗</span></a>
      </div>
      <div class="visha-featured-scroll" aria-label="Featured buying guides">
        {featured.map(guide => <GuideCard guide={guide} />)}
      </div>
      <p class="visha-rail-caption">{guides.length} in-depth guides · Independent research · Made for India</p>
    </div>
  </section>
  <section class="visha-discover-section" aria-labelledby="compare-heading">
    <div class="shell">
      <div class="visha-editorial-heading">
        <div>
          <span class="visha-small-label">DECISIONS MADE SIMPLE</span>
          <h2 id="compare-heading">Compare before you commit.</h2>
          <p>Understand what changes in everyday use, not just on a spec sheet.</p>
        </div>
        <a href="/comparisons/" class="visha-inline-link">All comparisons <span aria-hidden="true">↗</span></a>
      </div>
      <div class="visha-decision-grid">
        <a class="visha-decision-card visha-decision-card-dark" href="/guides/how-much-ram-for-developers/">
          <div><span class="visha-small-label">DEVELOPER ESSENTIALS</span><h3>16 GB or 32 GB?<br/>Know what you need.</h3><p>Memory decisions for IDEs, Docker and real development workloads.</p></div>
          <span class="visha-decision-art visha-memory-art" aria-hidden="true"><span>16<span>GB</span></span><span>32<span>GB</span></span></span>
          <span class="visha-card-action">Read the guide <span aria-hidden="true">↗</span></span>
        </a>
        <a class="visha-decision-card visha-decision-card-light" href="/comparisons/">
          <div><span class="visha-small-label">SIDE-BY-SIDE THINKING</span><h3>Choose with<br/>confidence.</h3><p>Storage, sound and everyday gear — compare the trade-offs that matter.</p></div>
          <span class="visha-decision-art visha-comparison-art" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="visha-card-action">Explore comparisons <span aria-hidden="true">↗</span></span>
        </a>
      </div>
    </div>
  </section>
  <section class="visha-finder-section" aria-labelledby="finder-heading">
    <div class="shell visha-finder-inner">
      <span class="visha-small-label">GUIDANCE THAT STARTS WITH YOU</span>
      <h2 id="finder-heading">Your needs first.<br/><span>Always.</span></h2>
      <p>Choose what you use, what matters, and what you can spend. We'll help you focus on the specifications worth checking.</p>
      <a href="/product-finder/" class="visha-pill-link">Find my tech fit <span aria-hidden="true">↗</span></a>
    </div>
  </section>
  <section class="visha-promise-section" aria-labelledby="promise-heading">
    <div class="shell visha-promise-inner">
      <div><span class="visha-small-label">THE VISHA PROMISE</span><h2 id="promise-heading">Helpful advice.<br/>No unnecessary hype.</h2></div>
      <div><p>We focus on practical specifications, transparent desk research, and the trade-offs you need to make a confident purchase. No invented hands-on tests or undisclosed paid placements.</p><a class="visha-inline-link" href="/editorial-policy/">Our editorial promise <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>
</BaseLayout>
