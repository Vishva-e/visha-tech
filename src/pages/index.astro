---
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideCard from '../components/GuideCard.astro';
import { categories } from '../data/site';
import { getCollection } from 'astro:content';
const guides = (await getCollection('guides', ({data}) => !data.draft)).sort((a,b) => b.data.updatedAt.getTime()-a.data.updatedAt.getTime());
const featured = [...guides].sort((a,b) => Number(b.data.featured)-Number(a.data.featured)).slice(0,3);
---
<BaseLayout title="Home" description="Discover smarter tech shopping with Visha Shop. Explore independent laptop, developer gear, audio and storage buying guides, comparisons and practical product advice.">
  <section class="hero hero-shop">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <span class="hero-kicker"><span class="hero-kicker-dot"></span> YOUR GUIDE TO BETTER TECH</span>
        <h1>Find tech that <span>fits your life.</span></h1>
        <p>Less scrolling, less second-guessing. Discover smart buying guides, useful comparisons and the gear that makes sense for <em>you</em>.</p>
        <form class="hero-search" action="/guides/" method="get" role="search">
          <label for="homepage-search" class="visually-hidden">Search buying guides</label>
          <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"></circle><path d="m16 16 5 5" stroke-linecap="round"></path></svg>
          <input id="homepage-search" name="q" type="search" placeholder="Search laptops, RAM, SSDs, headphones…" autocomplete="off" />
          <button type="submit">Search <span aria-hidden="true">↗</span></button>
        </form>
        <div class="hero-buttons">
          <a class="btn btn-primary" href="/guides/">Explore the guides <span aria-hidden="true">↗</span></a>
          <a class="btn btn-secondary" href="/product-finder/">Find my tech fit <span aria-hidden="true">→</span></a>
        </div>
        <div class="hero-proof"><span><span class="proof-icon">✓</span> Research-backed insights</span><span><span class="proof-icon">✓</span> Built for Indian buyers</span></div>
      </div>
      <div class="hero-showcase" aria-hidden="true">
        <div class="showcase-aura"></div>
        <div class="showcase-primary">
          <div class="showcase-overline"><span class="showcase-diamond">✳</span> THE VISHA EDIT <span class="showcase-year">2026</span></div>
          <div class="showcase-art">
            <div class="showcase-halo"></div>
            <div class="showcase-laptop">
              <div class="showcase-laptop-screen"><div class="showcase-screen-top"><i></i><i></i><i></i></div><div class="showcase-screen-content"><div class="showcase-screen-big"></div><div class="showcase-screen-line"></div><div class="showcase-screen-line short"></div></div></div>
              <div class="showcase-laptop-base"></div>
            </div>
          </div>
          <div class="showcase-caption"><span>01 / TECH ESSENTIALS</span><strong>Made for the way you work.</strong><p>Discover the upgrades worth considering.</p></div>
        </div>
        <div class="showcase-mini showcase-mini-top"><span class="showcase-mini-icon">⌨️</span><span><strong>Everyday essentials</strong><small>Keyboards, gear &amp; more</small></span></div>
        <div class="showcase-mini showcase-mini-bottom"><span class="showcase-mini-icon">✨</span><span><strong>Smart decisions</strong><small>Know what matters</small></span></div>
        <span class="showcase-spark showcase-spark-one">✦</span><span class="showcase-spark showcase-spark-two">✧</span>
      </div>
    </div>
  </section>
  <div class="trust-bar"><div class="shell trust-bar-inner"><span><strong>10</strong> in-depth guides</span><span class="trust-divider" aria-hidden="true"></span><span>Independent research</span><span class="trust-divider" aria-hidden="true"></span><span>No invented prices or reviews</span><span class="trust-divider" aria-hidden="true"></span><span>Made for India <span aria-hidden="true">✳</span></span></div></div>
  <section class="section section-categories section-white">
    <div class="shell">
      <div class="section-heading"><div><span class="eyebrow">SHOP BY INTEREST</span><h2>What's on your radar?</h2><p>From your next laptop to the little upgrades that make a big difference.</p></div><a class="text-link" href="/guides/">Explore all guides <span aria-hidden="true">↗</span></a></div>
      <div class="category-grid">{categories.map((category, index) => <a class="category-card" href={'/categories/' + category.slug + '/'}><span class="category-card-top"><span class="category-number">{String(index+1).padStart(2,'0')}</span><span class="category-arrow" aria-hidden="true">↗</span></span><span class="category-icon" aria-hidden="true">{category.icon}</span><span class="category-card-content"><h3>{category.name}</h3><p>{category.summary}</p></span></a>)}</div>
    </div>
  </section>
  <section class="section section-guides">
    <div class="shell">
      <div class="section-heading"><div><span class="eyebrow">THE GOOD STUFF</span><h2>Worth a closer look.</h2><p>Thoughtful, transparent buying guides to help you decide with confidence.</p></div><a class="text-link" href="/guides/">All buying guides <span aria-hidden="true">↗</span></a></div>
      <div class="guide-grid">{featured.map(guide => <GuideCard guide={guide} />)}</div>
    </div>
  </section>
  <section class="section section-white section-compare">
    <div class="shell compare-layout">
      <div class="compare-intro"><span class="eyebrow">DECISIONS, MADE SIMPLE</span><h2>Compare before<br/><span>you commit.</span></h2><p>Real-world trade-offs, side by side. Because the better choice depends on how you actually use your tech.</p><a href="/comparisons/" class="btn btn-primary">Explore comparisons <span aria-hidden="true">↗</span></a></div>
      <div class="compare-cards">
        <a href="/comparisons/?topic=ram" class="compare-tile"><span class="compare-symbol">🧠</span><span><strong>16 GB vs 32 GB RAM</strong><small>Find your ideal memory setup</small></span><span class="compare-tile-arrow" aria-hidden="true">↗</span></a>
        <a href="/comparisons/?topic=storage" class="compare-tile"><span class="compare-symbol">💾</span><span><strong>Internal vs external SSD</strong><small>Speed, convenience &amp; value</small></span><span class="compare-tile-arrow" aria-hidden="true">↗</span></a>
        <a href="/comparisons/?topic=audio" class="compare-tile"><span class="compare-symbol">🎧</span><span><strong>Wired vs wireless audio</strong><small>Better listening and calls</small></span><span class="compare-tile-arrow" aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
  <section class="section-commitment"><div class="shell"><div class="commitment"><div><span class="eyebrow">THE VISHA WAY</span><h2>Helpful advice.<br/>No unnecessary hype.</h2><p>We focus on specifications, practical use and real limitations. No invented hands-on tests or undisclosed paid placements — just a clearer path to your next tech decision.</p><a href="/editorial-policy/">Read our editorial promise <span aria-hidden="true">↗</span></a></div><div class="promise-points"><span><b>01</b> Real pros and trade-offs</span><span><b>02</b> Transparent research methods</span><span><b>03</b> Your needs come first</span></div></div></div></section>
</BaseLayout>
